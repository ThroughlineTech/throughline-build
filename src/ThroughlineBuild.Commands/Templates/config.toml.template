# Throughline Build configuration - generated by 'build init'
# Fill in all fields marked REQUIRED before running other build commands.

[ticketing]
backend = "plane"
plane_base_url = "REQUIRED_PLANE_BASE_URL"  # REQUIRED: set to your Plane API base URL (e.g. https://api.plane.so)
plane_workspace_slug = "REQUIRED_PLANE_WORKSPACE_SLUG"  # REQUIRED: your workspace slug
plane_project_id = "REQUIRED_PLANE_PROJECT_ID"  # REQUIRED: UUID of your Plane project
plane_api_token = "REQUIRED_PLANE_API_TOKEN"  # REQUIRED: your Plane API token
# plane_api_token_env = "PLANE_API_TOKEN"  # alternative for CI: read token from this env var

[llm]
# default_model is no longer used for worker-model selection. Worker models come
# from [workers.<agent>.sizes] below. It remains here only for the close/defer/
# reopen reason translator; setting it does NOT change which model a worker runs.
# default_model = "anthropic:claude-opus-4-8"           # Opus 4.8  - most capable
# default_model = "anthropic:claude-sonnet-4-6"         # Sonnet 4.6 - balanced
# default_model = "anthropic:claude-haiku-4-5-20251001" # Haiku 4.5 - fastest
# anthropic_api_key = "your-anthropic-key-here"         # optional; plan phase uses Claude Code OAuth instead
# anthropic_api_key_env = "ANTHROPIC_API_KEY"           # alternative for CI: read key from this env var

[workers]
# REQUIRED: name of the agent block that runs tickets by default ("claude-code", "codex", "gemini", "copilot").
default_agent = "claude-code"
timeout_minutes = 30

[workers.claude-code]
executable = "claude"
# max_output_tokens = 32000  # claude-code#24159 caps Opus 4.6 at 32000; do not raise above this

# Claude tiers use stable aliases (haiku/sonnet/opus) that auto-track the current
# model - never pin a Claude version here. The actually-resolved model still lands
# in the event log.
[workers.claude-code.sizes]
small  = { model = "haiku" }
medium = { model = "sonnet" }
large  = { model = "opus" }

# To add a new agent block, copy one of the commented-out examples below and
# fill in the executable and sizes. Each block is self-contained.

[workers.codex]
executable = "codex"
# max_output_tokens is not currently used but accepted for future use.
# bypass_permissions = true  # default true; disables Codex approvals and sandboxing.

[workers.codex.sizes]
# openai: prefix is optional; CodexAgent strips it automatically.
# effort is Codex-only (reasoning level: minimal | low | medium | high | xhigh).
small  = { model = "gpt-5.4-mini", effort = "low" }
medium = { model = "gpt-5.5", effort = "medium" }
large  = { model = "gpt-5.5", effort = "high" }

# [workers.gemini]
# executable = "gemini"
# # max_output_tokens is not currently used but accepted for future use.

# [workers.gemini.sizes]
# # google: prefix is optional; GeminiAgent strips it automatically.
# small  = { model = "gemini-2.0-flash" }
# medium = { model = "gemini-2.5-flash" }
# large  = { model = "gemini-2.5-pro" }

# [workers.copilot]
# executable = "copilot"
# # Auth: set GH_TOKEN in the environment for BYOK token auth (used when the
# # gh keyring credential is absent or you need a specific PAT).
# # Tool policy: pass extra flags via the extra_args config key (future extension)
# # or via WorkerOptions.AllowedTools at call time.

# [workers.copilot.sizes]
# # Use bare GitHub model IDs (the "github:" prefix is stripped automatically).
# small  = { model = "claude-3.5-sonnet" }
# medium = { model = "gpt-4o" }
# large  = { model = "claude-3.7-sonnet" }

[events]
log_directory = ".build/events"

# [review] is optional - omit entirely to use defaults (verifier_timeout_minutes=15, allowed tools=Read/Grep/Glob, no checks).
[review]
# Maximum time the verifier worker may run per review session.
verifier_timeout_minutes = 15
# Tools the verifier worker may use when reading the codebase.
# NOTE: only enforced for claude-code/copilot verifiers. codex and gemini ignore this
# (codex has no per-tool allowlist and its sandbox is unusable on Windows), so they run
# the verifier unsandboxed; review safety then relies on the prompt plus the post-review
# git-state guard. See TLB-478.
verifier_allowed_tools = ["Read", "Grep", "Glob"]

# Review checks are LEFT EMPTY on purpose. They are derived from your op-doc at
# 'build scaffold' time: the op-doc states the real toolchain in prose and the scaffold
# worker turns it into concrete checks. Until then there are no gating checks, so a
# project with no build/test step (e.g. one that just emits a JSON file) passes the gate
# cleanly instead of hard-failing on a phantom 'dotnet build'. To set checks by hand
# instead, uncomment the block matching your stack.
#
# Each [[review.checks]] entry defines an automated check run before the verifier.
# role = "gating"   -> non-zero exit hard-fails the gate; use for build, test, typecheck.
# role = "advisory" -> failure recorded and shown to verifier, never hard-fails; use for lint, format.
# role = "setup"    -> a prerequisite command (e.g. a codegen/install step) run ONCE before the checks,
#                      not a pass/fail check; a non-zero exit hard-fails the gate. Rarely needed - only
#                      when the build cannot run in a fresh worktree without it (e.g. `xcodegen generate`).
# Absent role defaults to "gating". A check absent from config is not-configured, never a failure.
#
# --- Example: .NET stack ---
# [[review.checks]]
# name = "build"
# executable = "dotnet"
# arguments = ["build", "--no-restore", "-c", "Release", "--nologo", "-v", "q"]
# timeout_minutes = 5
# role = "gating"
#
# [[review.checks]]
# name = "test"
# executable = "dotnet"
# arguments = ["test", "--no-build", "-c", "Release", "--nologo", "-v", "q", "--logger", "console;verbosity=minimal"]
# timeout_minutes = 10
# role = "gating"
#
# --- Example: Node / web stack ---
# [[review.checks]]
# name = "build"
# executable = "npm"
# arguments = ["run", "build"]
# timeout_minutes = 5
# role = "gating"
#
# [[review.checks]]
# name = "test"
# executable = "npm"
# arguments = ["test"]
# timeout_minutes = 10
# role = "gating"
#
# --- Advisory example (lint/format): records result, never hard-fails ---
# [[review.checks]]
# name = "lint"
# executable = "npm"
# arguments = ["run", "lint"]
# timeout_minutes = 5
# role = "advisory"

# [ship] is optional - omit entirely to use defaults (remote="origin", base_branch="main",
# delete_feature_branch=true, no regression_checks).
[ship]
remote = "origin"
base_branch = "main"
delete_feature_branch = true

# Regression checks run after rebase and conflict-marker scan, before the fast-forward
# merge. LEFT EMPTY on purpose - derived from your op-doc at 'build scaffold', same as
# [[review.checks]] above. No entries = no regression gate. Uncomment to set by hand.
#
# --- Example: .NET stack ---
# [[ship.regression_checks]]
# name = "build"
# executable = "dotnet"
# arguments = ["build", "--nologo", "--configuration", "Release", "-v", "q"]
# timeout_minutes = 5
# role = "gating"
#
# [[ship.regression_checks]]
# name = "test"
# executable = "dotnet"
# arguments = ["test", "--nologo", "--configuration", "Release", "--no-build", "-v", "q", "--logger", "console;verbosity=minimal"]
# timeout_minutes = 10
# role = "gating"
#
# --- Example: Node / web stack ---
# [[ship.regression_checks]]
# name = "build"
# executable = "npm"
# arguments = ["run", "build"]
# timeout_minutes = 5
# role = "gating"
#
# [[ship.regression_checks]]
# name = "test"
# executable = "npm"
# arguments = ["test"]
# timeout_minutes = 10
# role = "gating"

# [project] is optional - omit entirely to skip project-aware brief enrichment.
# The toolchain fields below are LEFT BLANK on purpose: they are derived from your op-doc
# at 'build scaffold' time. An all-blank toolchain assumes no stack (no phantom dotnet).
# Fill them in by hand only if you are not scaffolding from an op-doc.
[project]
# Primary implementation language (e.g. "csharp", "typescript", "python").
language = ""
# Framework or top-level stack (e.g. "dotnet", "react-vite", "django").
framework = ""
# Package/dependency manager (e.g. "dotnet", "npm", "pip", "uv").
package_manager = ""
# Common shell commands the brief can suggest to the worker.
build_command = ""
test_command = ""
install_command = ""
dev_command = ""
# REQUIRED: "build" if using this CLI; "claude-config" if using Claude Code slash commands.
workflow_tool = "build"
# Plane project browse URL prefix; informational for the worker.
plane_project_url = "https://plane.example.com/workspace/browse/PROJ/"
# Optional markdown file with extra project notes; path resolves relative to this config file.
# Missing files emit a stderr warning but do not fail the run.
# notes_file = ".build/project.md"
# Derived at 'build scaffold': stable, project-wide convention files inlined into EVERY implement
# brief so the worker does not re-read them - the test harness/setup file the runner auto-loads
# (vitest/jest setupFiles, pytest conftest.py, an xUnit shared fixture), the build/test config, and
# one canonical test example. Paths are relative to the project root; contents are read lazily per
# brief from the worktree.
# convention_files = ["src/setupTests.ts", "vite.config.ts", "src/data/__tests__/repository.test.ts"]
# Pre-load named-input + convention file contents into the implement brief (default true).
# Set false to ablate the lever and restore the pre-preload brief.
# preload_context = true

# [plan] mode controls the plan phase:
# "investigate" - spawn a worker to investigate the ticket and write the plan.
# "promote"     - bypass the investigation worker and promote the ticket plan in place.
[plan]
mode = "promote"
# mode = "investigate"  # uncomment to re-enable worker investigation

# [work] is optional - omit entirely to use [ship] base_branch as the worktree base.
# Set target_branch to override which branch new worktrees are cut from and
# what diffs are computed against. Useful when working on a long-running feature
# branch that is not yet main.
# [work]
# target_branch = "feature/my-feature"  # default: falls back to [ship] base_branch
#
# Unset this key (or remove it) to restore the [ship] base_branch fallback.
