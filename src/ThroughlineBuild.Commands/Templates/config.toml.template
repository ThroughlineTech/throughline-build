# Throughline Build configuration - generated by 'build init'
# Fill in all fields marked REQUIRED before running other build commands.
# Keep this template in lockstep with .build/config.toml.example

[ticketing]
backend = "plane"
plane_base_url = "REQUIRED_PLANE_BASE_URL"  # REQUIRED: set to your Plane API base URL (e.g. https://api.plane.so)
plane_workspace_slug = "REQUIRED_PLANE_WORKSPACE_SLUG"  # REQUIRED: your workspace slug
plane_project_id = "REQUIRED_PLANE_PROJECT_ID"  # REQUIRED: UUID of your Plane project
plane_api_token = "REQUIRED_PLANE_API_TOKEN"  # REQUIRED: your Plane API token
# plane_api_token_env = "PLANE_API_TOKEN"  # alternative for CI: read token from this env var

[llm]
# default_model = "anthropic:claude-opus-4-7"           # Opus 4.7  - most capable
# default_model = "anthropic:claude-sonnet-4-6"         # Sonnet 4.6 - balanced
# default_model = "anthropic:claude-haiku-4-5-20251001" # Haiku 4.5 - fastest
default_model = "anthropic:claude-opus-4-7"
# anthropic_api_key = "your-anthropic-key-here"         # optional; plan phase uses Claude Code OAuth instead
# anthropic_api_key_env = "ANTHROPIC_API_KEY"           # alternative for CI: read key from this env var

[workers]
# REQUIRED: name of the agent block that runs tickets by default ("claude-code", "codex", "gemini", "copilot").
default_agent = "claude-code"
timeout_minutes = 30

[workers.claude-code]
executable = "claude"
# max_output_tokens = 32000  # claude-code#24159 caps Opus 4.6 at 32000; do not raise above this

[workers.claude-code.sizes]
small  = "claude-haiku-4-5-20251001"
medium = "anthropic:claude-sonnet-4-6"
large  = "claude-opus-4-7"

# To add a new agent block, copy one of the commented-out examples below and
# fill in the executable and sizes. Each block is self-contained.

# [workers.codex]
# executable = "codex"
# # max_output_tokens is not currently used but accepted for future use.

# [workers.codex.sizes]
# # openai: prefix is optional; CodexAgent strips it automatically.
# small  = "o4-mini"
# medium = "o4-mini"
# large  = "o3"

# [workers.gemini]
# executable = "gemini"
# # max_output_tokens is not currently used but accepted for future use.

# [workers.gemini.sizes]
# # google: prefix is optional; GeminiAgent strips it automatically.
# small  = "gemini-2.0-flash"
# medium = "gemini-2.5-flash"
# large  = "gemini-2.5-pro"

# [workers.copilot]
# executable = "copilot"
# # Auth: set GH_TOKEN in the environment for BYOK token auth (used when the
# # gh keyring credential is absent or you need a specific PAT).
# # Tool policy: pass extra flags via the extra_args config key (future extension)
# # or via WorkerOptions.AllowedTools at call time.

# [workers.copilot.sizes]
# # Use bare GitHub model IDs (the "github:" prefix is stripped automatically).
# small  = "claude-3.5-sonnet"
# medium = "gpt-4o"
# large  = "claude-3.7-sonnet"

[events]
log_directory = ".build/events"

# [review] is optional - omit entirely to use defaults (verifier_timeout_minutes=15, allowed tools=Read/Grep/Glob, no checks).
[review]
# Maximum time the verifier worker may run per review session.
verifier_timeout_minutes = 15
# Tools the verifier worker is permitted to use when reading the codebase.
verifier_allowed_tools = ["Read", "Grep", "Glob"]

# Each [[review.checks]] entry defines an automated check run before the verifier.
# Failures are surfaced to the verifier but do not short-circuit the review.
[[review.checks]]
# Human-readable name shown in verifier context and event log.
name = "build"
# Executable to invoke (must be on PATH or an absolute path).
executable = "dotnet"
# Arguments passed to the executable.
arguments = ["build", "--no-restore", "-c", "Release"]
# Maximum time this check may run before it is killed and treated as failed.
timeout_minutes = 5

[[review.checks]]
name = "test"
executable = "dotnet"
arguments = ["test", "--no-build", "-c", "Release"]
timeout_minutes = 10

# [ship] is optional - omit entirely to use defaults (remote="origin", base_branch="main",
# delete_feature_branch=true, no regression_checks).
[ship]
remote = "origin"
base_branch = "main"
delete_feature_branch = true

# Regression checks run after rebase and conflict-marker scan, before the fast-forward merge.
[[ship.regression_checks]]
name = "build"
executable = "dotnet"
arguments = ["build", "--nologo", "--configuration", "Release"]
timeout_minutes = 5

[[ship.regression_checks]]
name = "test"
executable = "dotnet"
arguments = ["test", "--nologo", "--configuration", "Release", "--no-build"]
timeout_minutes = 10

# [project] is optional - omit entirely to skip project-aware brief enrichment.
[project]
# Primary implementation language (e.g. "csharp", "typescript", "python").
language = "csharp"
# Framework or top-level stack (e.g. "dotnet", "react-vite", "django").
framework = "dotnet"
# Package/dependency manager (e.g. "dotnet", "npm", "pip", "uv").
package_manager = "dotnet"
# Common shell commands the brief can suggest to the worker.
build_command = "dotnet build"
test_command = "dotnet test"
install_command = "dotnet restore"
dev_command = "dotnet run"
# REQUIRED: "build" if using this CLI; "claude-config" if using Claude Code slash commands.
workflow_tool = "build"
# Plane project browse URL prefix; informational for the worker.
plane_project_url = "https://plane.example.com/workspace/browse/PROJ/"
# Optional markdown file with extra project notes; path resolves relative to this config file.
# Missing files emit a stderr warning but do not fail the run.
# notes_file = ".build/project.md"

# [work] is optional - omit entirely to use [ship] base_branch as the worktree base.
# Set target_branch to override which branch new worktrees are cut from and
# what diffs are computed against. Useful when working on a long-running feature
# branch that is not yet main.
# [work]
# target_branch = "feature/my-feature"  # default: falls back to [ship] base_branch
#
# Unset this key (or remove it) to restore the [ship] base_branch fallback.
