<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ThroughlineBuild.Contracts\ThroughlineBuild.Contracts.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Briefs\ThroughlineBuild.Briefs.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Git\ThroughlineBuild.Git.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Helpers\ThroughlineBuild.Helpers.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Verification\ThroughlineBuild.Verification.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Workers.Common\ThroughlineBuild.Workers.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ThroughlineBuild.Phases.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The Cli composition-root test (ChainPhaseComposition) inspects the wired ChainPhase's
         internal BatchWorker/ChainShipFactory accessors to prove the chain verb did not drop a
         dependency. That phase object is composed in Cli, so its test assembly needs the grant. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ThroughlineBuild.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
