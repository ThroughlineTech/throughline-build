<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <AssemblyName>build</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcMaxParallelism>1</IlcMaxParallelism>
    <!--
      IL2104: Tomlyn rolls up trim-analysis warnings from its reflection-based ToModel<T>
      path. We only call the dynamic-model API (Toml.ToModel(string) -> TomlTable with
      TryGetValue/pattern-matching; see Config.cs / SetTargetCommand.cs), never the generic
      reflection path, so that code is unreachable at runtime and safe to trim. Suppress the
      assembly-level rollup so the AOT publish stays warning-clean.
    -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ThroughlineBuild.Contracts\ThroughlineBuild.Contracts.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Briefs\ThroughlineBuild.Briefs.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Commands\ThroughlineBuild.Commands.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Git\ThroughlineBuild.Git.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Phases\ThroughlineBuild.Phases.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Plane\ThroughlineBuild.Plane.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Anthropic\ThroughlineBuild.Anthropic.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.ModelClient\ThroughlineBuild.ModelClient.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Workers.ClaudeCode\ThroughlineBuild.Workers.ClaudeCode.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Workers.Codex\ThroughlineBuild.Workers.Codex.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Workers.Copilot\ThroughlineBuild.Workers.Copilot.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Workers.Gemini\ThroughlineBuild.Workers.Gemini.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.EventLog\ThroughlineBuild.EventLog.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Helpers\ThroughlineBuild.Helpers.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Verification\ThroughlineBuild.Verification.csproj" />
    <ProjectReference Include="..\ThroughlineBuild.Scaffold\ThroughlineBuild.Scaffold.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.16.0" />
  </ItemGroup>
</Project>
