<Project>
  <!--
    AOT publish fix: vswhere.exe is not in PATH in this environment so
    findvcvarsall.bat (called by the SetupOSSpecificProps target in
    Microsoft.NETCore.Native.Windows.targets) cannot discover MSVC.
    IlcUseEnvironmentalTools=true (set in Directory.Build.props) suppresses
    the vswhere call. This AfterTargets hook then sets CppLinker, CppLibCreator,
    and the lib search paths directly to the known locations on this machine,
    taking effect after SetupOSSpecificProps has run.

    Only active during a native-AOT publish. Managed builds and tests are
    unaffected; these properties are only consumed by the ILC link step.
  -->
  <Target Name="SetMsvcLinkerPaths"
          AfterTargets="SetupOSSpecificProps"
          Condition="'$(PublishAot)' == 'true'">
    <PropertyGroup>
      <_VcToolsRoot>C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\14.44.35207</_VcToolsRoot>
      <_WinSdkLib>C:\Program Files (x86)\Windows Kits\10\Lib\10.0.26100.0</_WinSdkLib>
      <CppLinker>$(_VcToolsRoot)\bin\Hostx64\x64\link.exe</CppLinker>
      <CppLibCreator>$(_VcToolsRoot)\bin\Hostx64\x64\lib.exe</CppLibCreator>
    </PropertyGroup>
    <ItemGroup>
      <AdditionalNativeLibraryDirectories Include="$(_VcToolsRoot)\lib\x64" />
      <AdditionalNativeLibraryDirectories Include="$(_WinSdkLib)\ucrt\x64" />
      <AdditionalNativeLibraryDirectories Include="$(_WinSdkLib)\um\x64" />
    </ItemGroup>
  </Target>
</Project>
