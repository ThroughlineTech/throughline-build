{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "build profile derive",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cli",
      "program": "${workspaceFolder}/src/ThroughlineBuild.Cli/bin/Debug/net10.0/build.dll",
      "args": ["profile", "derive"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": false
    },
    {
      "name": "build profile derive --force",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cli",
      "program": "${workspaceFolder}/src/ThroughlineBuild.Cli/bin/Debug/net10.0/build.dll",
      "args": ["profile", "derive", "--force"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": false
    }
  ]
}
